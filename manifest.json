
{
  "manifest_version": 3,
  "name": "WTFDoesThisMean",
  "version": "0.1.0",
  "description": "Understand words. Learn to use them naturally.",
 "permissions": [
  "storage",
  "contextMenus",
  "activeTab",
  "clipboardWrite"
],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "icons": {}
}
